{
  "rewrites": [
    {
      "source": "/api/kalshi/:path*",
      "destination": "https://api.elections.kalshi.com/trade-api/v2/:path*"
    },
    {
      "source": "/api/kalshi-public/:path*",
      "destination": "https://external-api.kalshi.com/trade-api/v2/:path*"
    },
    {
      "source": "/api/okx/:path*",
      "destination": "https://www.okx.com/api/v5/:path*"
    },
    {
      "source": "/api/bybit/:path*",
      "destination": "https://api.bybit.com/v5/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
